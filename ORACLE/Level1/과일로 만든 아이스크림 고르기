SELECT T.FLAVOR
FROM FIRST_HALF T,ICECREAM_INFO S
WHERE T.FLAVOR = S.FLAVOR 
AND T.TOTAL_ORDER > 3000 
AND S.INGREDIENT_TYPE = 'fruit_based'
ORDER BY T.TOTAL_ORDER DESC;
